{
	"name": "tacoberu/nette-form-selectboxremote",
	"description": "Select, which load options from remote.",
	"type": "library",
	"license": "MIT",
	"keywords": [
		"nette",
		"form",
		"select",
		"remote",
		"ajax"
	],
	"require": {
		"php" : ">=8.1",
		"nette/forms": "~3.1",
		"nette/application": "~3.1"
	},
	"require-dev": {
		"phpstan/phpstan": "^2.0",
		"slevomat/coding-standard": "^8.29",
		"rector/rector": "^2.0",
		"phpunit/phpunit": "^9.6"
	},
	"autoload": {
		"classmap": ["libs"]
	},
	"scripts": {
		"phpunit": "vendor/bin/phpunit",
		"phpcs": "vendor/bin/phpcs",
		"phpcbf": "vendor/bin/phpcbf",
		"phpstan": "phpstan analyse"
	},
	"config": {
		"platform": {
			"php": "8.1"
		},
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true
		}
	}
}
