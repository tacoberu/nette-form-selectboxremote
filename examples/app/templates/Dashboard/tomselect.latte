{block styles}
	<link href="https://cdn.jsdelivr.net/npm/tom-select@2.6.1/dist/css/tom-select.css" rel="stylesheet" />
{/}


{block scripts}
	<script src="https://cdn.jsdelivr.net/npm/tom-select@2.6.1/dist/js/tom-select.complete.min.js"></script>

	<script type="module">
		import { initTomSelectImpl } from "/js/TomSelectAdapter.js";

		function escapeOrEmpty(escape, value) {
			return value == null ? '' : escape(String(value));
		}

		// Decorated rendering: flag + country name.
		function renderCountry(data, escape) {
			const flag = data.flag ? escapeOrEmpty(escape, data.flag) + ' ' : '';
			return '<div>' + flag + escapeOrEmpty(escape, data.label) + '</div>';
		}

		// Decorated rendering: icon on the left, label and description stacked.
		function renderAccount(data, escape) {
			const icon = data.icon ? '<span>' + escapeOrEmpty(escape, data.icon) + '</span>' : '';
			const description = data.description
				? '<div style="font-size:0.85em;color:#777;">' + escapeOrEmpty(escape, data.description) + '</div>'
				: '';
			return (
				'<div style="display:flex;align-items:center;gap:0.5em;">' +
					icon +
					'<div><div>' + escapeOrEmpty(escape, data.label) + '</div>' + description + '</div>' +
				'</div>'
			);
		}

		document.querySelectorAll('select').forEach((el) => {
			let overrides = el.multiple ? { plugins: ['drag_drop'], create: true } : {};
			if (el.name === 'countries') {
				overrides = { ...overrides, render: { option: renderCountry, item: renderCountry } };
			}
			else if (el.name === 'accounts') {
				overrides = { ...overrides, render: { option: renderAccount, item: renderAccount } };
			}
			initTomSelectImpl(el, overrides);
		});
	</script>
{/}


{block content}

	<h1 n:block="title">Použití s TomSelect</h1>

	{include '../_default.menu.latte'}

	{control form}
